# 从 @BotFather 获取。不要把真实 Token 提交到代码仓库。
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# AI 自然语言功能。真实 API Key 只放在 VPS 的 .env，不能上传到 GitHub。
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-5.6-luna

# 使用 Sub2API 等中转服务时填写完整的 OpenAI 兼容地址，例如 https://你的域名/v1
# 使用 OpenAI 官方 API 时留空。
OPENAI_BASE_URL=

# 允许使用 AI 的 Telegram 数字用户 ID；多人用英文逗号分隔。
# 启动机器人后发送 /whoami 可查看自己的 ID。
AI_ALLOWED_TELEGRAM_USER_IDS=PASTE_YOUR_TELEGRAM_USER_ID_HERE

# 可选：默认 alerts.db
DATABASE_PATH=alerts.db
LOG_LEVEL=WARNING
